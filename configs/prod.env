# 安装根目录
GITFOX_WORKSPACE_ROOT_DIR=/data/gitfox-community
# 数据库连接
GITFOX_DB_HOST=mysql
GITFOX_DB_PORT=3306
GITFOX_DB_USER=gitfox
GITFOX_DB_PASSWORD=please_change
GITFOX_DB_NAME=gitfox
GITFOX_DB_TIMEZONE=Asia/Shanghai
GITFOX_DB_DRIVER=mysql

GITFOX_SERVER_PROTO=http
# 对外域名/ip
GITFOX_SERVER_HOST=example.com

# 代码库地址是否暴露端口
GITFOX_REPO_URL_EXPOSE_PORT=true

# GitFox http端口
GITFOX_HTTP_PORT=3000

# GitFox ssh端口
GITFOX_SSH_PORT=3322

# 禅道访问 域名+/api.php/v1
GITFOX_DEVOPS_URL=http://example.com/api.php/v1

# 日志输出的最低级别  -1~5：debug,info,warn,error,dpanic,panic,fatal
GITFOX_LOG_LEVEL=0

# Docker daemon 连接配置（使用标准 DOCKER_* 变量）。
# 进程环境变量（systemd Environment= / docker -e / shell export）优先于本文件；
# 不配置时默认连接本机 unix:///var/run/docker.sock。
# 远端 daemon 示例：
# DOCKER_HOST=tcp://10.0.0.xxx:2375
GITFOX_DOCKER_API_VERSION=1.41

# GITFOX_CI_PLUGINS_ZIP_URL=https://pkg.zentao.net/qucheng/gitfox/community/4.3/plugin.tar.gz

# SVN 导入/同步时忽略指定类型的证书校验失败（可选，如 unknown-ca；会降低 TLS 安全性）
# GITFOX_SVN_TRUST_SERVER_CERT_FAILURES=unknown-ca
